{
    "name": "skie/cake-pages",
    "description": "CakePages plugin for CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "cakephp/cakephp-codesniffer": "^5.0",
        "cakephp/bake": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "CakePages\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CakePages\\Test\\": "tests/",
            "TestApp\\": "tests/TestApp/",
            "TestPlugin\\": "tests/TestApp/Plugin/TestPlugin/src/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "scripts": {
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "stan": "phpstan analyse src/ tests/",
        "stan": "tools/phpstan analyse src/ tests/",
        "stan-test": "tools/phpstan analyse  tests/"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
